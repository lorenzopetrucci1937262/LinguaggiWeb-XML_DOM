<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="prenotazioni">
    <xs:complexType><xs:sequence>
      <xs:element name="spettacolo" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType><xs:sequence>
          <xs:element name="prenotazione" minOccurs="0" maxOccurs="unbounded">
            <xs:complexType>
              <xs:attribute name="id" type="xs:ID" use="required"/>
              <xs:attribute name="utente" type="xs:NCName" use="required"/>
              <xs:attribute name="posti" type="xs:positiveInteger" use="required"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="proiezione" type="xs:ID" use="required"/>
        <xs:attribute name="riepilogo" type="xs:string"/>
        <xs:attribute name="ultimoNumero" type="xs:positiveInteger" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence></xs:complexType>
  </xs:element>
</xs:schema>
